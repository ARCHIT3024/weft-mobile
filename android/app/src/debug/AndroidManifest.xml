<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- DEBUG BUILDS ONLY: the dev API is plain http (http://10.0.2.2:8000/v1
         from the emulator), and Android 9+ blocks cleartext traffic by default.
         This manifest is merged only into debug builds; staging and prod use
         https and keep the platform default (cleartext blocked). -->
    <application android:usesCleartextTraffic="true" />
</manifest>
